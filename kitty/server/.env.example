# Copy to kitty/server/.env (gitignored). Never commit real keys.

# Which LLM backend the server uses: "mock" (deterministic canned answers, no key needed) or "bharatcode".
LLM_PROVIDER=mock
# Mock only: wait this many ms before the first words, to try out the waiting screens (0 = answer at once).
MOCK_DELAY_MS=0

# Port for the local Kitty server.
PORT=8787

# BharatCode (OpenAI-compatible). Only needed when LLM_PROVIDER=bharatcode.
# Users can also bring their own key per request via the X-Kitty-Key header.
BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1
BHARATCODE_MODEL=glm-5.3-flash
BHARATCODE_API_KEY=

# Optional: Groq answers first (fast, small free limits) and BharatCode takes over when Groq is at its limit,
# a request is too big for it, or it fails before writing anything. Get a key at console.groq.com.
GROQ_API_KEY=
# qwen/qwen3.8-27b is a preview model on Groq. If Groq retires it, switch to llama-3.3-70b-versatile.
GROQ_MODEL=qwen/qwen3.8-27b

# Optional GitHub token (classic, only the public_repo scope: GitHub refuses CI log downloads to scope-less tokens). Raises REST API rate limits, enables code search for
# repo questions in the chat, and lets "Why did this fail?" read full GitHub Actions logs.
GITHUB_TOKEN=

# Requests per minute per IP when the server's own key is used.
RATE_LIMIT_PER_MIN=20

# Model streaming timeouts (ms): wait for the first words (BharatCode free-tier queueing can take 2-3 minutes),
# then max silence between chunks. Each feature also has a total cap under Vercel's 300 s limit (server/src/llm/budgets.ts).
LLM_FIRST_TOKEN_MS=230000
LLM_IDLE_MS=30000

# Repo tours are cached per owner/repo@commit for this many minutes.
TOUR_CACHE_TTL_MIN=360

# Optional: keep tours in Upstash Redis too, so they survive cold starts and all instances share them.
# Kitty also reads KV_REST_API_URL / KV_REST_API_TOKEN, the names Vercel's Upstash integration usually sets.
# Tours are keyed by commit, so a long expiry is safe.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TOUR_STORE_TTL_DAYS=30

# Answers to general chat questions (first question, no page or tour context) are kept this many days, in memory
# and in Redis when it's configured, so repeated questions skip the model.
ANSWER_CACHE_TTL_DAYS=14

# Upper limit on tour steps (4-15). Kitty picks 5-12 by repo size (small repos get shorter tours).
TOUR_MAX_STEPS=12
